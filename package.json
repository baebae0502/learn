{
  "name": "learn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "pnpm --filter @learn/desktop dev",
    "build": "pnpm --filter @learn/desktop build",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck && tsc -p tests/tsconfig.json",
    "test": "vitest run",
    "fixtures": "node fixtures/generate.mjs",
    "e2e": "pnpm build && pnpm fixtures && playwright test",
    "e2e:xvfb": "pnpm build && pnpm fixtures && xvfb-run -a -s \"-screen 0 1440x900x24\" playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "pdf-lib": "1.17.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "pnpm": { "onlyBuiltDependencies": ["better-sqlite3", "electron", "esbuild"] }
}
